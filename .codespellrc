[codespell]
# Preserve raw OCR fixture text, including mathematical variable names.
# Archived subtitle/OCR text is source material and must retain its original wording.
skip = .git,./public/subtitle_archive,*.pdf,*.svg,openapi.json,key.pem,Cargo.lock,yarn.lock,package.json,tsconfig.json,tsconfig.node.json,vite.config.ts,*ppt_animation_sequence.json
ignore-words-list = crate,ser,te,vaule
