{
  "build": {
    "beforeDevCommand": "yarn dev",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../python/attendance/nn.py": "python/attendance/nn.py",
      "../python/attendance/surveil.py": "python/attendance/surveil.py",
      "../python/attendance/requirements.txt": "python/attendance/requirements.txt",
      "../python/attendance/README.md": "python/attendance/README.md"
    },
    "createUpdaterArtifacts": false
  },
  "productName": "SJTU Canvas Helper",
  "mainBinaryName": "SJTU Canvas Helper",
  "version": "3.0.16",
  "identifier": "com.okabe.sjtu.canvas",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBNDQ2MDFFNDc4Qzk5RTEKUldUaG1ZeEhIbUJFbW9BMk85WFQrYzBTclZKNHdsS2xDYWp6M1h0MjRWR0hGWE5LOXgwdW9XWFQK",
      "active": false,
      "dialog": true,
      "endpoints": []
    }
  },
  "app": {
    "security": {
      "csp": "default-src 'self' http: https: data: blob: 'unsafe-eval' 'unsafe-inline'; connect-src 'self' http://localhost:* http://127.0.0.1:* http: https: ws: wss: wss://jaccount.sjtu.edu.cn; media-src 'self' http://localhost:* http://127.0.0.1:* https: blob: data:"
    },
    "windows": [
      {
        "title": "SJTU Canvas Helper",
        "width": 800,
        "height": 600,
        "maximized": true,
        "zoomHotkeysEnabled": false,
        "useHttpsScheme": false
      }
    ]
  }
}